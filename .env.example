# ogeduAI Environment Configuration Variables Template
# Copy this file to .env and fill in the values for production

# Database Settings
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ogedu_portal?retryWrites=true&w=majority

# AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Configurations
FIREBASE_PROJECT_ID=your_firebase_project_id_here
PORT=5000
NODE_ENV=production
