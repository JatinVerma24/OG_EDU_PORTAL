{
  "name": "ogedu-ai",
  "version": "1.0.0",
  "description": "Dynamic LPU Induction schedule and guide for freshers built on React + Express MERN-like stack.",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"cd frontend && npm run dev\" \"cd senior_portal/client && npm run dev\"",
    "build": "npm run build-fresher && npm run build-senior && next build",
    "build-hub": "next build",
    "build-fresher": "cd frontend && npm run build",
    "build-senior": "cd senior_portal/client && npm run build",
    "install-all": "npm install && cd frontend && npm install && cd ../senior_portal/client && npm install"
  },
  "dependencies": {
    "@sentry/node": "^10.65.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.46.0",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^9.7.0",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
